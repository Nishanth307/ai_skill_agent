# AI Skill Agent - Environment Variables

# --- Core Settings ---
APP_NAME="Skill Assessment Agent"
ENVIRONMENT=production
DEBUG=false

# --- LLM Backend ---
# Choose between "gemini" or "ollama"
LLM_BACKEND=gemini

# REQUIRED: Your Google AI Studio API Key (Free tier supported)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: If using Ollama locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# --- Infrastructure (Handled by Docker Compose) ---
DATABASE_URL=postgresql+asyncpg://skillagent:skillagent@postgres:5432/skillagentdb
REDIS_URL=redis://redis:6379

# --- Embeddings ---
EMBEDDING_BACKEND=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- UI Settings ---
# URL where the backend is accessible from the frontend container
API_BASE_URL=http://backend:8000/api/v1
